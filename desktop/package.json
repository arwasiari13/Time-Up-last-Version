{
  "name": "timeup-desktop",
  "private": true,
  "version": "1.0.1",
  "description": "TIME UP desktop app (Electron + React)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"npm:dev:electron\"",
    "dev:electron": "node electron/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node electron/dev.cjs --prod",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^38.1.2",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.2",
    "vite": "^6.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "firebase": "^12.19.0"
  },
  "author": "TIME UP",
  "build": {
    "appId": "com.timeup.desktop",
    "productName": "TIME UP",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TIME UP",
      "allowElevation": false,
      "runAfterFinish": true
    }
  }
}
